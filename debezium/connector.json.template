
{
  "name": "ecommerce-postgres-connector",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "tasks.max": "1",
    "database.hostname": "primary",
    "database.port": "5432",
    "database.user": "debezium",
    "database.password": "${DEBEZIUM_PASSWORD}",
    "database.dbname": "dataengfirst",
    "topic.prefix": "dataengfirst",
    "plugin.name": "pgoutput",
    "publication.name": "dbz_ecommerce_pub",
    "publication.autocreate.mode": "disabled",
    "slot.name": "debezium_dataengfirst",
    "slot.drop.on.stop": "false",
    "schema.include.list": "public",
    "table.include.list": "public.users,public.products,public.ecommerce_orders,public.ecommerce_order_items",
    "snapshot.mode": "initial",
    "decimal.handling.mode": "string"
  }
}
